# Central Intelligence Environment Configuration Template
# Copy to .env and replace all placeholder secrets before running `docker compose up`.
# Never commit .env or real credentials to version control.

# L5 Action — Nango Federated OAuth Gateway (REQUIRED, 32+ random hex/base64 chars)
NANGO_SECRET_KEY=replace-with-strong-random-nango-secret-key

# L12 Identity — Keycloak Admin Credentials (REQUIRED)
KEYCLOAK_ADMIN=replace-with-keycloak-admin-user
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password

# L12 Identity — OpenFGA Database Password
OPENFGA_POSTGRES_PASSWORD=replace-with-url-safe-openfga-database-password

# L13 Billing — Lago (REQUIRED; keep Lago's AGPL database isolated)
LAGO_POSTGRES_PASSWORD=replace-with-url-safe-lago-database-password
LAGO_SECRET_KEY_BASE=replace-with-64-character-random-secret
LAGO_RSA_PRIVATE_KEY=replace-with-base64-encoded-rsa-private-key
LAGO_ENCRYPTION_PRIMARY_KEY=replace-with-lago-primary-encryption-key
LAGO_ENCRYPTION_DETERMINISTIC_KEY=replace-with-lago-deterministic-encryption-key
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-lago-key-derivation-salt

# L1 Perception — LiveKit WebRTC API Key/Secret Pair (REQUIRED, format: "<api_key>: <api_secret>")
LIVEKIT_KEYS=replace-with-livekit-key: replace-with-livekit-secret

# L15 Data & L2/L3 Graph — PostgreSQL / Supabase / Apache AGE Credentials (REQUIRED)
POSTGRES_DB=postgres
AGE_POSTGRES_DB=postgres
AGE_POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# L4 Reasoning — Model Gateway / Provider Keys (Optional for local-only tests)
GATEWAY_URL=http://localhost:4000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
REASONING_GATEWAY_URL=http://localhost:4000
REASONING_GATEWAY_API_KEY=replace-with-authorized-reasoning-gateway-api-key

# Live integration target settings. These are used only by the explicitly selected
# live Compose suite; set credentials only for authorized disposable test services.
OPENFGA_LIVE_URL=http://localhost:8081
LAGO_LIVE_URL=http://localhost:3002
LAGO_API_KEY=
TEMPORAL_LIVE_URL=localhost:7233
POSTGRES_LIVE_URL=postgresql://postgres:replace-with-strong-postgres-password@localhost:5432/postgres
SANDBOX_LIVE=0
