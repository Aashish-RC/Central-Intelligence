# Central Intelligence Environment Configuration Template
# Copy to .env and replace all placeholder secrets before running `docker compose up`.
# Never commit .env or real credentials to version control.

# L5 Action — Nango Federated OAuth Gateway (REQUIRED, 32+ random hex/base64 chars)
NANGO_SECRET_KEY=replace-with-strong-random-nango-secret-key

# L3 Knowledge — Meilisearch Master Key (REQUIRED, 16+ random chars)
MEILISEARCH_MASTER_KEY=replace-with-strong-random-meilisearch-key

# L12 Identity — Keycloak Admin Credentials (REQUIRED)
KEYCLOAK_ADMIN=replace-with-keycloak-admin-user
KEYCLOAK_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password

# L12 Identity — Infisical Vault Encryption Key (REQUIRED, exactly 32-byte hex/string)
INFISICAL_ENCRYPTION_KEY=replace-with-32-byte-hex-encryption-key

# L1 Perception — LiveKit WebRTC API Key/Secret Pair (REQUIRED, format: "<api_key>: <api_secret>")
LIVEKIT_KEYS=replace-with-livekit-key: replace-with-livekit-secret

# L15 Data & L2/L3 Graph — PostgreSQL / Supabase / Apache AGE Credentials (REQUIRED)
POSTGRES_DB=postgres
AGE_POSTGRES_DB=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# L15 Messaging — Svix Webhook Delivery JWT Signing Secret (REQUIRED)
SVIX_JWT_SECRET=replace-with-strong-svix-jwt-secret

# L4 Reasoning — Model Gateway / Provider Keys (Optional for local-only tests)
GATEWAY_URL=http://localhost:4000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

